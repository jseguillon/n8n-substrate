apiVersion: v1
kind: Namespace
metadata:
  name: n8n-sandboxes
---
apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: n8n-sandbox
  namespace: n8n-sandboxes
  labels:
    workload: n8n-sandbox
spec:
  replicas: 2
  # Set to the digest-pinned gVisor worker image supplied by the installed
  # Substrate release. Do not use a mutable tag here.
  workerImage: ${SUBSTRATE_WORKER_IMAGE}
  sandboxClasses:
  - name: gvisor
  template:
    resources:
      limits:
        cpu: "4"
        memory: 8Gi
      requests:
        cpu: "1"
        memory: 8Gi
